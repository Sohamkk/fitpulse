# Copy this file to .env and fill in real values. Never commit .env.

FLASK_SECRET_KEY=change-me-to-a-random-string

# --- Email OTP (default channel) ---
# Gmail: turn on 2-Step Verification, then create an "App Password" at
# https://myaccount.google.com/apppasswords — use that here, not your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- SMS OTP (optional, needs a Twilio account) ---
USE_TWILIO=0
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=

# --- Google Sign-In (optional) ---
GOOGLE_CLIENT_ID=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
